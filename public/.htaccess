# Apache configuration for the static export (Hetzner webhosting).
# This file lives in public/ and is copied to out/ by `npm run build`.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS redirect -------------------------------------------------------
  # Requires a valid SSL certificate for bostanci-art.alkanaziz.com (konsoleH).
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # --- Old export URLs ------------------------------------------------------
  # Earlier builds produced /route.html. Redirect those to the new /route/ URLs.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)\.html$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Browsers remember this for one year: keep the SSL certificate auto-renewing.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Hashed build assets never change: cache for one year.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML and RSC payloads (.txt) must always be revalidated after a deploy.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Artwork and site images keep their file names, so use a moderate lifetime.
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
